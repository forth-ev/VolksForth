                  : ?key  ( -- c )   BEGIN ?rx key? UNTIL key ;                                                                                                                                                                                                                                                                                 \ quit! forth! shell!                                clv 08apr90                                                                [link  Variable fils                                                                                                              : quit!   t>ww>d bye ;           callit" quit     "                                                                             : shell!  t>ww>s msdos s>ww>t ;  callit" shell    "                                                                                                                                             : .volksForth  origin $102 + count type ;                                                                                       : forth!  t>ww>f .volksForth ." -- Type BYE to reenter "           callForth f>ww>t '.tops ;      callit" forth    "                                                                                                                                                                                                          \ tibMove rFn tFn pFn file:                          clv 13jun89                                                                  Create rFn ," RECEIVE-.TRM                           "          Create tFn ," TRANSMIT.TRM                           "          Create pFn ," PROTOCOL.PRT                           "          Create sFn ," T4.COM                                 "                                                                          : file: ( buf --  | string )                                       ." File:" input_Filename   at? drop 0 at                        IF r> withProt >r tibMove ELSE rdrop THEN ;                  \ Schreibt in den Input-Buffer                                                                                                                                                                                                                                                                                                                                                                \ transmit! receive! protocol!                       clv 13jun89                                                                  : transmit! onMsg  tFn file: transmit ; callit" transmit "      : receive!  onMsg  rFn file: receive ;  callit" receive  "      : protocol! onMsg  protFile @                                      IF protend ELSE   pFn file: protocol THEN ;                                                            callit" protocol "    : saveTerm  [ link @ ] Literal fils !                                      flush  $100 here savefile ;                          : saveTerm! onMsg sFn file: saveTerm ;    callit" saveTerm "                                                                    link @ fils !  cycle link]                                                                                                    \\ SAVESYSTEM geht in SAVETERM! nicht, da SAVE die                 User-Variablen sichert und so alle Systemvektor-Verbiegerei     zunichte macht.                                              \ specials                                           clv 13jun89                                                                [link  Variable spls                                              Create sFn ," SEND----.SCR                           "          Create fromScr  ," 000"         Create toScr    ," 000"         : waitAnswer BEGIN stop? abort" aborted" rx? UNTIL                           BEGIN rx? WHILE 'rx drop REPEAT ;                  : tScrLin  onMsg  sFn file: use cr                                 ." from:" fromScr input_dFix nip 0=exit  cr                     ." to:"   toScr   input_dFix nip 0= IF drop exit THEN cr        1+ swap ?DO at? I u. at I  b/blk 0 DO                             I c/l + I DO                                                      dup block I + c@  'tx  LOOP #cr 'tx waitAnswer                c/l +LOOP  LOOP drop ; callit" tScrLin "                   link @ spls !  cycle link]                                                                                                    \ tops atTop its .top                                clv 23mai89                                                                [link  Variable tops                                                                                                              : atTop   at? drop  tops @ 6 + c@  at ;                         : its  ( -- adr )   tops @ 7 + perform ;                        : .top  stay  its .it ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       \ xtop0 xtop1                                        clv 25mai89                                                                  : xtop0     1 att  .top                                            BEGIN get                                                             top? IF 0 att .top                 unget exit THEN               cr? IF 0 att .top  its doit  #esc unget exit THEN               ud? IF IF its cycle-! ELSE its cycle+! THEN .top           ELSE drop bell THEN      REPEAT ;                                                                                          : xtop1     1 att  .top                                            BEGIN get                                                             top? IF unget  0 att  .top      exit THEN                        ud? IF IF its cycle-! ELSE its cycle+! THEN .top                       its doit                                            ELSE drop bell THEN      REPEAT ;                                                                                        \ atTops xtops .tops tops+ tops-                     clv 13jun89                                                                    ' .top  ' xtop0 callit    0 c,  ' fils ,                        ' .top  ' xtop1 callit  &09 c,  ' coms ,                        ' .top  ' xtop1 callit  &14 c,  ' pars ,                        ' .top  ' xtop1 callit  &19 c,  ' bits ,                        ' .top  ' xtop1 callit  &25 c,  ' hass ,                        ' .baud ' baud! callit  &34 c,       0 ,                        ' .top  ' xtop1 callit  &42 c,  ' echs ,                        ' .top  ' xtop0 callit  &53 c,  ' spls ,                      link @ tops !  cycle  link]                                                                                                                                                                                                                                                                                                                                                                   \ .top top!                                          clv 08apr90                                                                  : .tops  onStatus 0 att page                                       tops push  [ tops @ ] Literal  tops !                           BEGIN atTop  tops .it  tops cycle+!                                   [ tops @ ] Literal  tops @ = UNTIL ;                                                                                   ' .tops Is '.tops     \ resolve forward                                                                                         : top!  onStatus                                                   BEGIN atTop  tops doit   get #esc case? ?exit                            rl? IF IF tops cycle+! ELSE tops cycle-! THEN                          THEN REPEAT ;                                                                                                                                                                                                                              \\                                                   clv 13jun89                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \ term termquit     - level 1                        clv 13jun89                                                                  : termquit termArea cur! .tops                                     BEGIN pause                                                           rx?  IF 'rx drop THEN                                           key? IF key #esc case? IF top! ELSE 'tx THEN THEN               REPEAT ;                                                                                                               : terminst                                                         ['] msgError errorhandler !                                     ['] termquit Is 'quit                                           here off ;  \ warum?                                                                                                                                                                                                                                                                                                       \ termcold bye - Level 1                             clv 08apr90                                                                  : termcold  s_cold                                                 dosWW                      \ Dos-Fenster bernehmen             ['] 'tx >body @ >r         \ Echo-Mode sichern                  ['] txNoEcho Is 'tx        \ Echo aus (=fullduplex)             interpret                  \ Kommandozeile verarbeiten          r> Is 'tx                  \ Echo-Mode restaurieren             d>ww>t                     \ von DOS- auf TERM-Fenster          .rev ." -- <ESC> = special Functions" cr cr                     terminst quit ;            \ TERM-Hauptschleife                                                                            ' termcold Is 'cold                                                                                                                                                                                                                                                                                                  clv 13jun89                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \  test                                              clv 18mai89                                                                  : .w ibm-at? . . key drop ;                                     dww 6 + 2@ . .                                                                                                                  : .dww dww .vid ;                                                                                                               .dww                                                            ' noop is .status                                               debug quit!                                                                                                                                                                                                                                                                                                                                                                                                                                                   \                                                    clv 08apr90                                                                verschiedene Files werden INCLUDEd, bei UTI.SCR werden            die gewnschten Worte namentlich genannt                                                                                      ByeNoCLS entfernt das l„stige PAGE aus BYE (bei 3.81.41 n”tig)                                                                  .REV - hier sollte bei Ver„nderungen eine neue Zahl rein                                                                        ACHTUNG!! BYE wird ver„ndert. Bitte ENDTERM benutzen.                                                                                                                                                                                                                                                                                                                                                                                                           \ ..areas.. atts att                                 clv 06jun89                                                                STATLIN TERMAREA are the statusline-Area on the screen and         the terminal-Area above. The MSG area is defined near           MSGERROR in UTI.SCR                                                                                                          THESCREEN is the whole-screen-Area only used with ALLPAGE.                                                                      ATTS holds the screenattributes used to display the               statusline-Items normal and selected.                                                                                         ATT  is used to select one of the ATTS-screen-Attributes for      subsequent output.                                                                                                                                                                                                                                            \ Window-Handling                                    clv 06jun89no other methods should be used on windows than the following:  ONSTATUS ONTERM ONMSG activates the appropriate area for           subsequent output, reactivating the previous area after         leaving the calling words.                                      Sideeffects: All of them change the return-stack.               ONSTATUS puts protocol off, it also saves the                    active-cursor-area and restores it.                            ONMSG also pages the MSG-Area.                                                                                               D>WW>T T>WW>D  T>WW>S S>WW>T  T>WW>F F>WW>T                       are used to save and restores screen-contents while changing    from Dos<-->Term  Term<-->Shell  Term<-->Forth.                 If you use one of a pair, don't forget the other.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             \ callit" doit .it it!                               clv 06jun89                                                                A base for a User-Interface.                                    A sequence like                                                                                                                 [link  Variable l                                                  : x1 ..do1.. ;    callit" action1 "                             : x2 ..do2.. ;    callit" action2 "                             : .x3 ." action3 "                                              : x3 ..do3.. ;    ' .x3 ' x3 callit                             link @  l !  cycle link]                                                                                                     makes a linked cyclic list like this:( l-->l1-->l2-->l3-->l1-..)l --> ..l1.. CFA_of_x1  CFA_of_a_routine_which_prints:"action1"       ..l2.. CFA_of_x2  CFA_of_a_routine_which_prints:"action2"       ..l3.. CFA_of_x3  CFA_of_.x3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   clv 18mai89                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \ coms                                               clv 06jun89                                                                see also the COMS-definition in TERMSER.SCR.                                                                                    The user-interface works like this:                                an additional pointer is saved within the parameter-field,      which holds the link-pointer produced by CALLIT".               Thus the COMS-Pointer can be set to the correct                 link-pointer when typing in COM1 from forth.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 \ hands XON/XOFF RTS/DTR RTS                         clv 13jun89                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \                                                    clv 06jun89                                                                                                                                                                                                                                                                                                                                                                                                FILE: is not an example for good programming style, I think.      First it writes to the Forth-Terminal-Input-Buffer to lay       down the Filename, which will be read later.                    Second the r>..>r are necessary for installing the              LATER-section of withProt. Not good to read.                    Third it uses RDROP to leave the calling word if necessary,     so don't use it other than used on the next screen.                                                                                                                                           \ transmit! receive! protocol!                       clv 06jun89                                                                TRANSMIT! RECEIVE! PROTOCOL! SAVETERM!                            all of them switches Output to ONMSG, uses FILE: to put         a filename (which can be edited by the user) into               the Input-Stream where it will be taken by TRANSMIT etc.                                                                      PROTOCOL! closes the protocolfile first, if any.                SAVETERM! sets FILS to the LINK (of compile-time!!) so            that 'quit' will be displayed when starting this com-file.      saveterm don't uses SAVESYSTEM, it executes no SAVE.            So no added forth-words are saved. This is necessary, because   SAVE saves all User-Variables, like used Areas, output-vector   etc....                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       \ tops atTop its .top                                clv 06jun89                                                                TOPS adds all linked list produced till yet to a meta-list,       It is a list of lists.                                          This linked list differs from those seen till yet. It is        build like the others but a screen-column is saved at           offset 6 which can be used with ATTOP and a pointer to the      sub-list at offset 7 which can be get by ITS.                                                                                 You can use:                                                      TOPS DOIT to execute the actual top.                            TOPS .IT  to display the actual top.                            ATTOP     to set the cursor to the column of actual top.        ITS  DOIT to execute the actual selected item under top         ITS  .IT  to display the actual item under actual top.        What means execute and display here? See 2 screens later.       \ xtop0 xtop1                                        clv 06jun89                                                                XTOP0 and XTOP1 reads a key from the keyboard, leaves if the       char shall be handled by TOP! (<right>,<left>,<esc>),           switches item under actual top (<up>,<down>).                   If other keys are typed in, it beeps.                                                                                        XTOP1 executes the seleced item directly after selection. Thus     if you see 'com1' on the screen an types <down> you will        see 'com2' on the screen and simultaneously 'com2' is           executed without a <cr> received from the user.                                                                              XTOP0 waits after selection of an item for a <CR>. So if           you see 'quit' on the screen you have to type <cr> to           execute it. After execution it will be leaved automatically     as if a <esc> was pressed also                               \ atTops xtops .tops tops+ tops-                     clv 06jun89                                                                Now the user-interface-top-level is being created                                                                               All tops use .TOP as print-action, so that TOPS .IT will           result in the same as ITS .IT . Only .BAUD is a special         case because it is not list-organized as the other. It          perhaps can be called direct-top-level-action.                                                                                  All other tops use XTOP0 or XTOP1 as execution-action.                                                                                                                                                                                                                                                                                                                                                                                                       \ .top top!                                          clv 06jun89                                                                .TOPS outputs the statusline                                                                                                    TOP! is executed after typing <esc>                                  it executes the actual top until <esc> is pressed.              if <right> or <left> are pressed it changes actual top.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         clv 06jun89                                                                                                                                                                                                                                                                                                                                                                                                TERMINST changes errorhandler and mainloop-handler ( QUIT )                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          clv 13jun89installs TERMCOLD as startup-vector.                                                                                             Videoverbiegerei, damit auch receive in INTERPRET geht.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        \ test                                               clv 08jun89   old_s_int >s_int !  empty                                    \\                                                                 $20 >label I_ctrl       $21 >label I_mask   \ 8259 addresses                                                                 \  4 loadfrom term.scr          \ altes S_INT                   \  s_int >s_int ! \ patch                                          ' old_s_int Alias s_int                                                                                                      \  5 loadfrom term.scr          \ altes RX? RX                                                                                     6 loadfrom term.scr          \ altes S_INIT geht                                                                                : tq BEGIN queue @ u. queue 2+ @ u. cr  stop? UNTIL ;           s_init  t                                                                                                                                                                         clv 13mai00                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     clv 13mai00                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     clv 13mai00                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     clv 13mai00                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                